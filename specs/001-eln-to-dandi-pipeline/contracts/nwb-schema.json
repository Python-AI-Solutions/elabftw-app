      "species": "http://purl.obolibrary.org/obo/NCBITaxon_10090",
      "strain": "C57BL/6J",
      "sex": "M",
      "date_of_birth": "2024-06-15T00:00:00+00:00",
      "weight": "25.3 g",
      "description": "Healthy male mouse for fiber photometry experiments"
    },
    "NWBFile": {
      "session_start_time": "2025-10-27T10:00:00+00:00",
      "session_id": "M001_2025-10-27_fear_conditioning",
      "session_description": "fear_conditioning",
      "experimenter": ["Dr. John Doe"],
      "experiment_description": "Fear conditioning with fiber photometry recording in NAc",
      "protocol": "fear_conditioning",
      "institution": "National Institutes of Health",
      "lab": "Tejeda Lab",
      "source_script": "elabftw-app@0af5abb3e8d9f72c1b4a5e6d7f8c9d0e1f2a3b4c",
